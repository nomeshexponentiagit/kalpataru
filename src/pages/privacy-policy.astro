---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { SITE } from '../data/site';
---

<!-- ALL LEGAL TEXT ON THIS PAGE IS DUMMY / PLACEHOLDER.
     Replace with real, reviewed legal text before launch. -->

<Layout
	title="Privacy Policy — Kalpataru Exhibition"
	description="How Kalpataru Exhibition collects, uses and protects your information."
>
	<PageHero
		eyebrow="Legal"
		lines={['Privacy Policy']}
		subtitle="How we collect, use and protect your information."
		compact
	/>

	<section class="section legal tone-white">
		<div class="container">
			<article class="prose" data-reveal>
				<p>
					<!-- DUMMY — real effective date to be added -->
					Last updated: August 2026
				</p>
				<p>
					<!-- DUMMY intro -->
					Kalpataru Exhibition ("we", "us") respects your privacy. This policy explains what
					information we collect through this website, why we collect it, and the choices you
					have.
				</p>

				<h2>Information we collect</h2>
				<!-- DUMMY — confirm the actual data collected by the real enquiry flow -->
				<p>We may collect information you provide directly, such as:</p>
				<ul>
					<li>Your name, company name, email address and phone number when you send an enquiry.</li>
					<li>Details about your project that you include in your message.</li>
				</ul>
				<p>
					We may also collect limited technical information automatically, such as your browser
					type and the pages you visit, to keep the website working properly.
				</p>

				<h2>How we use your information</h2>
				<!-- DUMMY — align with real business processes -->
				<p>We use the information we collect to:</p>
				<ul>
					<li>Respond to your enquiries and prepare proposals.</li>
					<li>Deliver services you have requested.</li>
					<li>Improve this website and the way we communicate.</li>
				</ul>

				<h2>Cookies</h2>
				<!-- DUMMY — verify which cookies the production site actually sets -->
				<p>
					This website currently does not use advertising or tracking cookies. If this changes,
					we will update this policy and ask for your consent where required.
				</p>

				<h2>Sharing your information</h2>
				<!-- DUMMY — confirm any third parties involved in real operations -->
				<p>
					We do not sell your personal information. We may share it with service providers who
					help us operate the business (for example, email services), and only to the extent
					needed to provide those services.
				</p>

				<h2>Data retention</h2>
				<!-- DUMMY -->
				<p>
					We keep enquiry information only as long as needed to serve you and to meet our legal
					obligations.
				</p>

				<h2>Your rights</h2>
				<!-- DUMMY -->
				<p>
					You may ask us to access, correct or delete the personal information we hold about
					you. Write to us at <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and we will
					respond within a reasonable time.
				</p>

				<h2>Contact</h2>
				<!-- DUMMY -->
				<p>
					Questions about this policy? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or
					call {SITE.phone}.
				</p>
			</article>
		</div>
	</section>
</Layout>
