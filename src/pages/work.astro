---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Button from '../components/ui/Button.astro';
import { WORK_GROUPS } from '../data/work';

/**
 * The portfolio page. Photos and client captions are REAL — pulled from
 * the live kalpataruexhibition.com portfolio (user-approved source) and
 * generated into src/data/work.ts. Sector blurbs in work.ts are our own
 * copy (marked DUMMY there until the user approves the wording), and each
 * item's date/event is a DUMMY placeholder pending the real data.
 *
 * One grid, filtered by category pills; the lightbox steps through the
 * currently visible tiles.
 */

const ALL_ITEMS = WORK_GROUPS.flatMap((group) =>
	group.items.map((item) => ({ ...item, category: group.category }))
);

const ALL_BLURB = `All ${ALL_ITEMS.length} builds across engineering, real estate and jewellery — photographed at their shows. Pick a category to filter the grid.`;

const altFor = (client: string, category: string) =>
	client === category
		? `${category} exhibition stall built by Kalpataru`
		: `Exhibition stall for ${client}, built by Kalpataru`;
---

<Layout
	title="Work — Kalpataru Exhibition"
	description="The Kalpataru Exhibition portfolio — real stalls built for engineering, real estate and jewellery brands."
>
	<PageHero
		eyebrow="Our work"
		lines={['Built to be', 'seen']}
		subtitle="Every photo below is a real Kalpataru Exhibition stall, photographed at its show — across engineering, real estate and jewellery."
		media="/images/work-hero.jpg"
		mediaAlt="An exhibition stall for ESBEE Realty, built by Kalpataru"
	/>

	<section class="section gallery-head tone-white">
		<div class="container">
			<div class="gallery-head__bar" data-reveal>
				<div class="gallery-head__filters" role="group" aria-label="Filter work by category">
					<button
						class="filter-pill is-active"
						type="button"
						data-filter="all"
						data-blurb={ALL_BLURB}
						aria-pressed="true"
					>
						All categories
					</button>
					{
						WORK_GROUPS.map((group) => (
							<button
								class="filter-pill"
								type="button"
								data-filter={group.category}
								data-blurb={group.blurb}
								aria-pressed="false"
							>
								{group.category}
							</button>
						))
					}
				</div>
				<p class="gallery-head__count" data-gallery-count aria-live="polite">
					{ALL_ITEMS.length} builds
				</p>
			</div>
			<p class="gallery-head__blurb" data-gallery-blurb data-reveal>
				{ALL_BLURB}
			</p>
		</div>
	</section>

	<section class="section gallery tone-white">
		<div class="container">
			<ul class="gallery__grid">
				{
					ALL_ITEMS.map((item) => (
						<li class="gallery__item" data-category={item.category}>
							<button
								class="work-card"
								type="button"
								data-gallery-item
								data-src={item.src}
								data-client={item.client}
								data-event={item.event}
								data-date={item.date}
							>
								<span class="work-card__media">
									<img
										src={item.src}
										alt={altFor(item.client, item.category)}
										loading="lazy"
										decoding="async"
										width="900"
									/>
									<span class="work-card__tag">{item.category}</span>
								</span>
								<span class="work-card__body">
									<span class="work-card__client">{item.client}</span>
									<span class="work-card__event">{item.event}</span>
									<span class="work-card__date">Exhibited · {item.date}</span>
								</span>
							</button>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section gallery-cta theme-dark tone-accent">
		<div class="container gallery-cta__inner">
			<h2 class="gallery-cta__title" data-reveal>Have a show coming up?</h2>
			<p class="gallery-cta__copy" data-reveal>
				Send us the dates and the floor plan — we'll come back with a concept, a design
				and a budget.
			</p>
			<div class="gallery-cta__actions" data-reveal>
				<Button href="/contact" variant="solid">Start your project</Button>
				<Button href="/services" variant="ghost">What we do</Button>
			</div>
		</div>
	</section>

	<!-- Lightbox: opens any gallery card full-size. Keyboard:
	     Esc closes, ←/→ step, click on the backdrop closes. -->
	<div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Project photo">
		<button class="lightbox__close" data-lightbox-close type="button" aria-label="Close">
			<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path d="M3 3l10 10M13 3 3 13" stroke="currentColor" stroke-width="1.4"
					stroke-linecap="round"></path>
			</svg>
		</button>
		<button class="lightbox__nav lightbox__nav--prev" data-lightbox-prev type="button" aria-label="Previous photo">
			<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path d="M10 2.5 4.5 8l5.5 5.5" stroke="currentColor" stroke-width="1.4"
					stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</button>
		<figure class="lightbox__stage">
			<img data-lightbox-img src="" alt="" />
			<figcaption class="lightbox__cap">
				<span class="lightbox__cap-main">
					<span data-lightbox-client></span>
					<span data-lightbox-sub></span>
				</span>
				<span data-lightbox-count></span>
			</figcaption>
		</figure>
		<button class="lightbox__nav lightbox__nav--next" data-lightbox-next type="button" aria-label="Next photo">
			<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path d="m6 2.5 5.5 5.5L6 13.5" stroke="currentColor" stroke-width="1.4"
					stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</button>
	</div>
</Layout>

<style>
	/* ------------------------------------------------------------ filter bar */
	.gallery-head {
		padding-bottom: clamp(2.2rem, 4.5vw, 3.5rem);
	}

	.gallery-head__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 1.6rem;
	}

	.gallery-head__filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.filter-pill {
		padding: 0.55rem 1.1rem;
		border: 1px solid var(--line-strong);
		background: transparent;
		font: inherit;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink-dim);
		cursor: pointer;
		transition: border-color 0.3s var(--ease-swift), background-color 0.3s var(--ease-swift),
			color 0.3s var(--ease-swift);
	}

	.filter-pill:hover {
		border-color: var(--accent);
		color: var(--ink);
	}

	.filter-pill.is-active {
		border-color: var(--accent-deep);
		background: var(--accent-deep);
		color: var(--bg-raised);
	}

	.filter-pill:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.gallery-head__count {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.gallery-head__blurb {
		margin-top: 1.3rem;
		max-width: 56ch;
		font-size: 0.92rem;
		line-height: 1.7;
		color: var(--ink-dim);
	}

	/* ------------------------------------------------------------------ grid */
	.gallery {
		padding-top: clamp(2.2rem, 4.5vw, 3.5rem);
	}

	.gallery__grid {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(0.9rem, 2vw, 1.5rem);
	}

	.gallery__item.is-hidden {
		display: none;
	}

	/* -------------------------------------------------------------- the card */
	.work-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		width: 100%;
		padding: 0;
		border: 1px solid var(--line);
		background: var(--bg-raised);
		overflow: hidden;
		cursor: zoom-in;
		text-align: left;
		transition: border-color 0.35s var(--ease-swift), transform 0.35s var(--ease-swift),
			box-shadow 0.35s var(--ease-swift);
	}

	.work-card:hover {
		transform: translateY(-4px);
		border-color: var(--line-strong);
		box-shadow: 0 16px 32px rgba(16, 37, 43, 0.1);
	}

	.work-card:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.work-card__media {
		position: relative;
		display: block;
		overflow: hidden;
	}

	.work-card__media img {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		transition: transform 0.7s var(--ease-swift);
	}

	.work-card:hover img {
		transform: scale(1.045);
	}

	.work-card__tag {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		padding: 0.32rem 0.62rem;
		background: rgba(14, 13, 12, 0.74);
		color: #f4efe6;
		font-size: 0.56rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.work-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.05rem 1.15rem 1.2rem;
	}

	.work-card__client {
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.35;
		color: var(--ink);
	}

	.work-card__event {
		font-size: 0.82rem;
		line-height: 1.45;
		color: var(--ink-dim);
	}

	.work-card__date {
		margin-top: 0.2rem;
		font-size: 0.6rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	/* soft re-entrance when the filter changes */
	.gallery__item.is-enter .work-card {
		animation: card-in 0.5s var(--ease-out) both;
	}

	@keyframes card-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* ------------------------------------------------------------------ CTA */
	.gallery-cta__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.4rem;
		text-align: center;
	}

	.gallery-cta__title {
		font-size: clamp(1.8rem, 3.6vw, 3rem);
		font-weight: 550;
		letter-spacing: -0.02em;
	}

	.gallery-cta__copy {
		max-width: 46ch;
		font-size: 0.95rem;
		line-height: 1.7;
		color: var(--ink-dim);
	}

	.gallery-cta__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
		margin-top: 0.6rem;
	}

	/* -------------------------------------------------------------- lightbox */
	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 1200;
		display: none;
		place-items: center;
		padding: clamp(4.5rem, 8vw, 6.5rem) clamp(0.75rem, 4vw, 3.5rem) clamp(1rem, 4vw, 2.5rem);
		background: rgba(12, 11, 10, 0.94);
	}

	.lightbox.is-open {
		display: grid;
	}

	.lightbox__stage {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		max-width: min(92vw, 72rem);
	}

	.lightbox__stage img {
		display: block;
		max-width: 100%;
		max-height: 74vh;
		width: auto;
		height: auto;
		object-fit: contain;
	}

	.lightbox__cap {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: baseline;
		gap: 0.6rem 1.2rem;
		color: #f4efe6;
		font-size: 0.9rem;
		font-weight: 550;
	}

	.lightbox__cap-main {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.35rem 0.9rem;
	}

	.lightbox__cap-main [data-lightbox-sub] {
		color: rgba(244, 239, 230, 0.65);
	}

	.lightbox__cap [data-lightbox-count] {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: rgba(244, 239, 230, 0.6);
	}

	.lightbox__close {
		position: absolute;
		top: clamp(0.9rem, 3vw, 1.8rem);
		right: clamp(0.9rem, 3vw, 1.8rem);
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid rgba(244, 239, 230, 0.45);
		background: transparent;
		color: #f4efe6;
		cursor: pointer;
		transition: border-color 0.3s var(--ease-swift), background-color 0.3s var(--ease-swift);
	}

	.lightbox__close:hover {
		border-color: #f4efe6;
		background: rgba(244, 239, 230, 0.08);
	}

	.lightbox__close svg {
		width: 1rem;
		height: 1rem;
	}

	.lightbox__nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		display: grid;
		place-items: center;
		width: 2.9rem;
		height: 2.9rem;
		border: 1px solid rgba(244, 239, 230, 0.45);
		background: transparent;
		color: #f4efe6;
		cursor: pointer;
		transition: border-color 0.3s var(--ease-swift), background-color 0.3s var(--ease-swift);
	}

	.lightbox__nav:hover {
		border-color: #f4efe6;
		background: rgba(244, 239, 230, 0.08);
	}

	.lightbox__nav svg {
		width: 1.05rem;
		height: 1.05rem;
	}

	.lightbox__nav--prev {
		left: clamp(0.5rem, 2.5vw, 2rem);
	}

	.lightbox__nav--next {
		right: clamp(0.5rem, 2.5vw, 2rem);
	}

	/* ------------------------------------------------------------- responsive */
	@media (max-width: 899px) {
		.gallery__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 599px) {
		.gallery__grid {
			grid-template-columns: 1fr;
		}

		.gallery-head__bar {
			flex-direction: column;
			align-items: flex-start;
		}

		.lightbox {
			padding-inline: 3.2rem;
		}

		.lightbox__nav {
			width: 2.4rem;
			height: 2.4rem;
		}
	}
</style>

<script>
	// Category filter + lightbox. Pure vanilla — every card is a button with
	// the photo path, client, event and date in its data attributes. The
	// lightbox steps through the tiles currently visible after filtering.
	const items = Array.from(document.querySelectorAll<HTMLElement>('.gallery__item'));
	const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
	const count = document.querySelector<HTMLElement>('[data-gallery-count]');
	const blurb = document.querySelector<HTMLElement>('[data-gallery-blurb]');

	const visibleTiles = () =>
		Array.from(
			document.querySelectorAll<HTMLButtonElement>(
				'.gallery__item:not(.is-hidden) [data-gallery-item]'
			)
		);

	const applyFilter = (category: string, button: HTMLButtonElement) => {
		for (const pill of filters) {
			const on = pill === button;
			pill.classList.toggle('is-active', on);
			pill.setAttribute('aria-pressed', String(on));
		}
		let visible = 0;
		for (const li of items) {
			const show = category === 'all' || li.dataset.category === category;
			li.classList.toggle('is-hidden', !show);
			if (show) visible++;
		}
		if (count) count.textContent = `${visible} ${visible === 1 ? 'build' : 'builds'}`;
		if (blurb && button.dataset.blurb) blurb.textContent = button.dataset.blurb;
		// soft re-entrance on the cards that just appeared
		for (const li of items) {
			if (li.classList.contains('is-hidden')) continue;
			li.classList.remove('is-enter');
			void li.offsetWidth;
			li.classList.add('is-enter');
		}
	};

	for (const button of filters) {
		button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'all', button));
	}

	/* ------------------------------------------------------------- lightbox */
	const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');
	const lbImg = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-img]');
	const lbClient = lightbox?.querySelector<HTMLElement>('[data-lightbox-client]');
	const lbSub = lightbox?.querySelector<HTMLElement>('[data-lightbox-sub]');
	const lbCount = lightbox?.querySelector<HTMLElement>('[data-lightbox-count]');
	const lbClose = lightbox?.querySelector<HTMLButtonElement>('[data-lightbox-close]');
	const lbPrev = lightbox?.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
	const lbNext = lightbox?.querySelector<HTMLButtonElement>('[data-lightbox-next]');

	if (lightbox && lbImg && lbClient && lbSub && lbCount) {
		let tiles: HTMLButtonElement[] = [];
		let index = 0;
		let lastFocus: HTMLElement | null = null;

		const render = () => {
			const tile = tiles[index];
			lbImg.src = tile.dataset.src ?? '';
			lbImg.alt = tile.dataset.client ?? '';
			lbClient.textContent = tile.dataset.client ?? '';
			lbSub.textContent = `${tile.dataset.event ?? ''} · ${tile.dataset.date ?? ''}`;
			lbCount.textContent = `${index + 1} / ${tiles.length}`;
		};

		const open = (tile: HTMLButtonElement) => {
			tiles = visibleTiles();
			index = Math.max(0, tiles.indexOf(tile));
			lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
			render();
			lightbox.classList.add('is-open');
			document.body.style.overflow = 'hidden';
			lbClose?.focus();
		};

		const close = () => {
			lightbox.classList.remove('is-open');
			document.body.style.overflow = '';
			lastFocus?.focus();
		};

		const step = (dir: number) => {
			index = (index + dir + tiles.length) % tiles.length;
			render();
		};

		for (const tile of visibleTiles()) {
			tile.addEventListener('click', () => open(tile));
		}
		lbClose?.addEventListener('click', close);
		lbPrev?.addEventListener('click', () => step(-1));
		lbNext?.addEventListener('click', () => step(1));
		lightbox.addEventListener('click', (event) => {
			if (event.target === lightbox) close();
		});
		document.addEventListener('keydown', (event) => {
			if (!lightbox.classList.contains('is-open')) return;
			if (event.key === 'Escape') close();
			if (event.key === 'ArrowLeft') step(-1);
			if (event.key === 'ArrowRight') step(1);
		});
	}
</script>
