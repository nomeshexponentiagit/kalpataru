---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SITE } from '../data/site';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;

// Mobile bottom tab bar — 5 fixed links (user-specified: icon above label).
// WhatsApp is built from SITE.phone so it stays correct when the real
// number lands. (The number is still DUMMY.)
const phoneDigits = SITE.phone.replace(/\D/g, '');
const whatsappHref = `https://wa.me/${phoneDigits}`;
const activePath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f2f6f4" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/brand/logo.png" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- TODO — verify canonical/OG urls against the production domain once live -->
		<link rel="canonical" href={`${SITE.url}${Astro.url.pathname}`} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${SITE.url}${Astro.url.pathname}`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<!-- TODO — add og:image / twitter:image once a real social preview image exists -->
		<!-- fonts (Manrope + Inter) are self-hosted in public/fonts/ and declared in global.css -->
		<script is:inline>
			// gates JS-only styles/behaviour; motion never hides content when JS is off
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />

		<!-- mobile-only sticky bottom tab bar (hidden on desktop + menu open):
		     5 columns, icon above label — layout specified by the user -->
		<nav class="sticky-cta" aria-label="Quick navigation">
			<a
				class:list={['sticky-cta__item', activePath === '/work' && 'is-active']}
				href="/work"
				aria-current={activePath === '/work' ? 'page' : undefined}
			>
				<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<rect x="2" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.3"></rect>
					<rect x="9" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.3"></rect>
					<rect x="2" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.3"></rect>
					<rect x="9" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.3"></rect>
				</svg>
				Work
			</a>
			<a
				class:list={['sticky-cta__item', activePath === '/services' && 'is-active']}
				href="/services"
				aria-current={activePath === '/services' ? 'page' : undefined}
			>
				<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<rect
						x="2.5"
						y="5"
						width="11"
						height="8.5"
						rx="1"
						stroke="currentColor"
						stroke-width="1.3"></rect>
					<path
						d="M6 5V4a1.5 1.5 0 0 1 1.5-1.5h1A1.5 1.5 0 0 1 10 4v1M2.5 9.5h11"
						stroke="currentColor"
						stroke-width="1.3"
						stroke-linecap="round"></path>
				</svg>
				Services
			</a>
			<a
				class:list={['sticky-cta__item', activePath === '/' && 'is-active']}
				href="/"
				aria-current={activePath === '/' ? 'page' : undefined}
			>
				<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path
						d="M2.5 7.5 8 2.8l5.5 4.7"
						stroke="currentColor"
						stroke-width="1.3"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
					<path
						d="M4 7v6h8V7M6.5 13v-3h3v3"
						stroke="currentColor"
						stroke-width="1.3"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
				Home
			</a>
			<a
				class:list={['sticky-cta__item', activePath === '/contact' && 'is-active']}
				href="/contact"
				aria-current={activePath === '/contact' ? 'page' : undefined}
			>
				<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<rect
						x="2"
						y="3.5"
						width="12"
						height="9"
						rx="1"
						stroke="currentColor"
						stroke-width="1.3"></rect>
					<path
						d="m2.5 4.5 5.5 4.6 5.5-4.6"
						stroke="currentColor"
						stroke-width="1.3"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
				Contact Us
			</a>
			<a
				class="sticky-cta__item"
				href={whatsappHref}
				target="_blank"
				rel="noopener"
			>
				<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path
						d="M8 1.8a6.2 6.2 0 0 0-5.4 9.3L1.8 14l3-.8A6.2 6.2 0 1 0 8 1.8Z"
						stroke="currentColor"
						stroke-width="1.3"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
					<path
						d="M6.2 6.4c-.2.4.1 1.4.9 2.5.8 1.1 1.7 1.7 2.1 1.5"
						stroke="currentColor"
						stroke-width="1.3"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
				WhatsApp
			</a>
		</nav>

		<script>
			import '../scripts/main';
		</script>
	</body>
</html>
