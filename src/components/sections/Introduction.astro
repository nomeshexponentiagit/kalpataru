---
import SectionLabel from '../ui/SectionLabel.astro';
---

<section class="section intro" id="about">
	<div class="container intro__grid">
		<div class="intro__label" data-reveal>
			<SectionLabel text="Who we are" />
		</div>

		<h2 class="intro__statement" data-reveal>
			We turn empty exhibition space into experiences people remember<span class="intro__period">.</span>
		</h2>

		<div class="intro__side">
			<p class="intro__copy" data-reveal>
				Kalpataru provides exhibition design, fabrication and turnkey execution — from the first
				concept sketch and 3D design through production and on-site installation.
			</p>
			<!-- DUMMY FACT — replace with verified company facts (e.g. year established, team, credentials) -->
			<p class="intro__fact" data-reveal>
				Delivering exhibition experiences across India, Japan, China and the USA since 2014.
			</p>
		</div>
	</div>
</section>

<style>
	.intro__grid {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: 2rem;
		align-items: start;
	}

	.intro__label {
		grid-column: 1 / 3;
	}

	.intro__statement {
		grid-column: 3 / 10;
		font-size: clamp(1.85rem, 4.1vw, 3.6rem);
		font-weight: 550;
		letter-spacing: -0.02em;
		line-height: 1.14;
		max-width: 24ch;
	}

	.intro__period {
		color: var(--accent);
	}

	.intro__side {
		grid-column: 10 / 13;
		display: flex;
		flex-direction: column;
		gap: 1.6rem;
	}

	.intro__copy {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--ink-dim);
	}

	.intro__fact {
		padding-left: 1.1rem;
		border-left: 2px solid var(--accent);
		font-size: 0.86rem;
		font-style: italic;
		line-height: 1.6;
		color: var(--ink-dim);
	}

	@media (max-width: 1023px) {
		.intro__label {
			grid-column: 1 / -1;
		}

		.intro__statement {
			grid-column: 1 / 11;
		}

		.intro__side {
			grid-column: 1 / -1;
			margin-left: auto;
			max-width: 40rem;
		}
	}

	@media (max-width: 767px) {
		/* 12 track + gap system can't fit below ~390px; stack fully */
		.intro__grid {
			grid-template-columns: 1fr;
			gap: 1.6rem;
		}

		.intro__statement {
			grid-column: 1 / -1;
		}
	}
</style>
