---
import PlaceholderImage from '../ui/PlaceholderImage.astro';
import SectionLabel from '../ui/SectionLabel.astro';

const INDUSTRIES = [
	'Pharmaceuticals',
	'Chemicals',
	'Automation',
	'Machinery',
	'Power',
	'Energy',
	'Jewellery',
	'FMCG',
	'Real Estate',
] as const;

const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="section industries theme-dark" id="industries">
	<!-- background layer: the visual for the active industry crossfades in (see scripts/main.ts).
	     DUMMY IMAGES — replace /images/industry-N.jpg with real project photography -->
	<div class="industries__bg" data-industries-bg aria-hidden="true">
		{
			INDUSTRIES.map((_, i) => (
				<div class:list={['industries__bg-item', i === 0 && 'is-active']} data-industry-bg={i}>
					<PlaceholderImage
						src={`/images/industry-${i + 1}.jpg`}
						alt=""
						aspect="auto"
						decorative
					/>
				</div>
			))
		}
	</div>
	<div class="industries__scrim" aria-hidden="true"></div>

	<div class="container industries__inner">
		<div class="section-head">
			<div>
				<SectionLabel text="Industries" />
				<h2 class="section-head__title">
					Designed around<br />your industry.
				</h2>
			</div>
		</div>

		<ul class="industries__list" data-industries-list>
			{
				INDUSTRIES.map((name, i) => (
					<li>
						<button class="industry-row" type="button" data-industry={i} aria-label={`Show visual for ${name}`}>
							<span class="industry-row__num">{pad(i + 1)}</span>
							<span class="industry-row__name">{name}</span>
							<span class="industry-row__arrow" aria-hidden="true">
								<svg viewBox="0 0 16 16" fill="none">
									<path
										d="M2 8h11M9 3.5 13.5 8 9 12.5"
										stroke="currentColor"
										stroke-width="1.4"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</span>
						</button>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.industries {
		position: relative;
		overflow: hidden;
		/* dark backstop behind the parallaxing media */
		background: #10252b;
	}

	.industries__bg {
		position: absolute;
		inset: 0;
	}

	.industries__bg-item {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 0.7s var(--ease-swift);
	}

	.industries__bg-item.is-active {
		opacity: 0.4;
	}

	.industries__bg-item :global(.ph) {
		height: 100%;
	}

	.industries__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(14, 13, 12, 0.92) 0%, rgba(14, 13, 12, 0.86) 50%, rgba(14, 13, 12, 0.94) 100%);
	}

	.industries__inner {
		position: relative;
		z-index: 1;
	}

	.industry-row {
		display: grid;
		grid-template-columns: 3.5rem 1fr auto;
		align-items: center;
		gap: 1.25rem;
		width: 100%;
		padding-block: clamp(0.85rem, 1.6vw, 1.25rem);
		text-align: left;
		border-bottom: 1px solid var(--line);
		transition: border-color 0.4s var(--ease-swift);
	}

	.industry-row__num {
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.26em;
		color: var(--ink-faint);
		transition: color 0.35s var(--ease-swift);
	}

	.industry-row__name {
		font-size: clamp(1.7rem, 3.4vw, 3.1rem);
		font-weight: 550;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		color: var(--ink-dim);
		transition: transform 0.5s var(--ease-swift), color 0.35s var(--ease-swift);
	}

	.industry-row__arrow {
		color: var(--accent);
		opacity: 0;
		transform: translateX(-0.5rem);
		transition: opacity 0.4s var(--ease-swift), transform 0.4s var(--ease-swift);
	}

	.industry-row__arrow svg {
		width: 1.3rem;
		height: 1.3rem;
	}

	.industry-row:hover .industry-row__name,
	.industry-row.is-active .industry-row__name,
	.industry-row:focus-visible .industry-row__name {
		transform: translateX(clamp(0.75rem, 2vw, 1.5rem));
		color: var(--ink);
	}

	.industry-row:hover .industry-row__num,
	.industry-row.is-active .industry-row__num,
	.industry-row:focus-visible .industry-row__num {
		color: var(--accent);
	}

	.industry-row:hover .industry-row__arrow,
	.industry-row.is-active .industry-row__arrow,
	.industry-row:focus-visible .industry-row__arrow {
		opacity: 1;
		transform: none;
	}

	@media (max-width: 767px) {
		/* simplified on mobile: no background layer, rows only */
		.industries__bg {
			display: none;
		}

		/* slimmer number column + vw-scaled name so the longest
		   label ("Pharmaceuticals") fits at 320px viewports */
		.industry-row {
			grid-template-columns: 2.25rem minmax(0, 1fr);
			gap: 0.75rem;
		}

		.industry-row__name {
			font-size: clamp(1.1rem, 6.5vw, 1.7rem);
			color: var(--ink);
		}

		.industry-row__arrow {
			display: none;
		}
	}
</style>
