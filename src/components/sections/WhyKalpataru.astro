---
import SectionLabel from '../ui/SectionLabel.astro';

/**
 * Capability list from the brief — factual claims beyond this
 * (years, volumes, certifications) must be verified before adding.
 */
const CAPABILITIES = [
	{ num: '01', title: 'Design', desc: 'In-house concept and 3D design development.' },
	{ num: '02', title: 'Fabrication', desc: 'Quality-controlled production and finishing.' },
	{ num: '03', title: 'Project Management', desc: 'A single point of contact from kickoff to handover.' },
	{ num: '04', title: 'International Execution', desc: 'Coordination across India and international markets.' },
	{ num: '05', title: 'Installation', desc: 'On-site build, dressing and detail finishing.' },
	{ num: '06', title: 'End-to-End Delivery', desc: 'One team accountable for the complete project.' },
] as const;
---

<section class="section why theme-dark tone-accent">
	<div class="container">
		<div class="section-head">
			<div>
				<SectionLabel text="Why Kalpataru" />
				<h2 class="section-head__title">Built on capability.</h2>
			</div>
		</div>

		<div class="why__grid">
			{
				CAPABILITIES.map((cap) => (
					<div class="why__item" data-reveal>
						<span class="why__num">{cap.num}</span>
						<h3 class="why__title">{cap.title}</h3>
						<p class="why__desc">{cap.desc}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.why__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: clamp(2.5rem, 5vw, 5rem) clamp(2rem, 5vw, 6rem);
	}

	.why__item {
		position: relative;
		padding-top: 1.6rem;
		border-top: 1px solid var(--line);
	}

	/* accent tick that slides in on hover */
	.why__item::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 0;
		width: 2.5rem;
		height: 1px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.5s var(--ease-swift);
	}

	.why__item:hover::before {
		transform: scaleX(1);
	}

	.why__num {
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.26em;
		color: var(--accent);
	}

	.why__title {
		margin-top: 0.9rem;
		font-size: clamp(1.4rem, 2.2vw, 2rem);
		text-transform: uppercase;
	}

	.why__desc {
		margin-top: 0.65rem;
		font-size: 0.88rem;
		line-height: 1.7;
		color: var(--ink-dim);
		max-width: 34ch;
	}

	@media (max-width: 767px) {
		.why__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
