---
import SectionLabel from '../ui/SectionLabel.astro';

const STEPS = [
	{ num: '01', title: 'Discover', desc: 'Understanding your brand, brief and audience.' },
	{ num: '02', title: 'Design', desc: 'Concept, 3D visualisation and design development.' },
	{ num: '03', title: 'Build', desc: 'Fabrication, finishing and quality control.' },
	{ num: '04', title: 'Deliver', desc: 'Logistics, installation and handover.' },
	{ num: '05', title: 'Experience', desc: 'Your stand live, on show, on schedule.' },
] as const;
---

<section class="section process tone-tint">
	<div class="container">
		<div class="section-head">
			<div>
				<SectionLabel text="How we work" />
				<h2 class="section-head__title">The process.</h2>
			</div>
		</div>

		<ol class="process__steps">
			{
				STEPS.map((step) => (
					<li class="process__step" data-reveal>
						<span class="process__num" aria-hidden="true">{step.num}</span>
						<h3 class="process__title">{step.title}</h3>
						<p class="process__desc">{step.desc}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.process__steps {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: clamp(1.5rem, 3vw, 3rem);
		counter-reset: process;
	}

	.process__step {
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}

	.process__num {
		display: block;
		font-size: clamp(2.8rem, 5vw, 4.4rem);
		font-weight: 650;
		line-height: 1;
		letter-spacing: -0.02em;
		-webkit-text-fill-color: transparent;
		-webkit-text-stroke: 1px rgba(21, 19, 16, 0.38);
		user-select: none;
	}

	.process__title {
		margin-top: 1.2rem;
		font-size: 1rem;
		font-weight: 650;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.process__desc {
		margin-top: 0.6rem;
		font-size: 0.86rem;
		line-height: 1.65;
		color: var(--ink-dim);
	}

	@media (max-width: 1023px) {
		.process__steps {
			grid-template-columns: 1fr;
			gap: 2.25rem;
		}

		.process__step {
			padding: 0 0 0 1.5rem;
			border-top: 0;
			border-left: 1px solid var(--line);
			position: relative;
		}

		.process__step::before {
			content: '';
			position: absolute;
			left: -3px;
			top: 0;
			width: 5px;
			height: 5px;
			background: var(--accent);
		}

		.process__num {
			font-size: 2.4rem;
		}

		.process__title {
			margin-top: 0.9rem;
		}
	}
</style>
