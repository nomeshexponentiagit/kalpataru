---
import SectionLabel from '../ui/SectionLabel.astro';
import { CITIES } from '../../data/site';

const MARKETS = ['India', 'Japan', 'China', 'USA'] as const;
---

<section class="section global" id="locations">
	<div class="container">
		<div class="section-head">
			<div>
				<SectionLabel text="Global presence" />
				<h2 class="section-head__title">
					One partner.<br />multiple markets.
				</h2>
			</div>
		</div>

		<div class="global__grid">
			<ul class="global__markets">
				<li class="global__market" data-reveal>
					<span class="global__name">India</span>
					<span class="global__cities">{CITIES.join(' · ')}</span>
				</li>
				{
					MARKETS.slice(1).map((market) => (
						<li class="global__market" data-reveal>
							<span class="global__name">{market}</span>
						</li>
					))
				}
			</ul>

			<!-- abstract route diagram: hubs + connections, no external map dependency -->
			<div class="global__map" data-reveal>
				<svg
					class="route-map"
					viewBox="0 0 760 520"
					role="img"
					aria-label="Abstract route map showing Kalpataru's markets: India, Japan, China and the USA"
				>
					<line class="route-map__route" x1="150" y1="330" x2="560" y2="120" />
					<line class="route-map__route" x1="150" y1="330" x2="520" y2="250" />
					<line class="route-map__route" x1="150" y1="330" x2="680" y2="330" />
					<line class="route-map__route route-map__route--local" x1="560" y1="120" x2="520" y2="250" />
					<line class="route-map__route route-map__route--local" x1="150" y1="330" x2="100" y2="270" />
					<line class="route-map__route route-map__route--local" x1="150" y1="330" x2="160" y2="360" />
					<line class="route-map__route route-map__route--local" x1="150" y1="330" x2="185" y2="400" />
					<line class="route-map__route route-map__route--local" x1="150" y1="330" x2="200" y2="330" />

					<g class="route-map__hub" transform="translate(150 330)">
						<circle class="route-map__hub-ring" r="16" />
						<circle class="route-map__hub-core" r="4" />
					</g>
					<g class="route-map__hub" transform="translate(560 120)">
						<circle class="route-map__hub-ring" r="12" />
						<circle class="route-map__hub-core" r="3.5" />
					</g>
					<g class="route-map__hub" transform="translate(520 250)">
						<circle class="route-map__hub-ring" r="12" />
						<circle class="route-map__hub-core" r="3.5" />
					</g>
					<g class="route-map__hub" transform="translate(680 330)">
						<circle class="route-map__hub-ring" r="12" />
						<circle class="route-map__hub-core" r="3.5" />
					</g>

					<circle class="route-map__dot" cx="100" cy="270" r="3" />
					<circle class="route-map__dot" cx="160" cy="360" r="3" />
					<circle class="route-map__dot" cx="185" cy="400" r="3" />
					<circle class="route-map__dot" cx="200" cy="330" r="3" />

					<text class="route-map__label" x="150" y="298">INDIA</text>
					<text class="route-map__label route-map__label--city" x="112" y="252">DELHI</text>
					<text class="route-map__label route-map__label--city" x="172" y="352">MUMBAI</text>
					<text class="route-map__label route-map__label--city" x="197" y="418">PUNE</text>
					<text class="route-map__label route-map__label--city" x="212" y="322">HYDERABAD</text>
					<text class="route-map__label" x="576" y="102">JAPAN</text>
					<text class="route-map__label" x="536" y="232">CHINA</text>
					<text class="route-map__label" x="696" y="316">USA</text>
				</svg>
			</div>
		</div>
	</div>
</section>

<style>
	.global__grid {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: center;
	}

	.global__markets {
		grid-column: 1 / 6;
	}

	.global__market {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding-block: 1.4rem;
		border-top: 1px solid var(--line);
	}

	.global__markets .global__market:last-child {
		border-bottom: 1px solid var(--line);
	}

	.global__name {
		font-size: clamp(1.8rem, 3vw, 2.7rem);
		font-weight: 550;
		letter-spacing: -0.01em;
		text-transform: uppercase;
	}

	.global__cities {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	/* --------------------------------------------------------- route map */

	.global__map {
		grid-column: 7 / 13;
	}

	.route-map {
		width: 100%;
		height: auto;
	}

	.route-map__route {
		stroke: var(--line-strong);
		stroke-width: 1;
		stroke-dasharray: 3 7;
		animation: route-flow 26s linear infinite;
	}

	.route-map__route--local {
		stroke-dasharray: 1 4;
		opacity: 0.75;
	}

	@keyframes route-flow {
		to {
			stroke-dashoffset: -200;
		}
	}

	.route-map__dot {
		fill: var(--ink-dim);
	}

	.route-map__hub-ring {
		fill: none;
		stroke: var(--line-strong);
		stroke-width: 1;
	}

	.route-map__hub-core {
		fill: var(--accent);
		animation: hub-pulse 3s var(--ease-out) infinite;
		transform-origin: center;
	}

	@keyframes hub-pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.35;
		}
	}

	.route-map__label {
		fill: var(--ink-dim);
		font-family: var(--font-sans);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.28em;
	}

	.route-map__label--city {
		fill: var(--ink-faint);
		font-size: 9px;
		letter-spacing: 0.22em;
	}

	@media (max-width: 1023px) {
		/* children span the full row here, so collapse the 12-track system */
		.global__grid {
			grid-template-columns: 1fr;
		}

		.global__markets,
		.global__map {
			grid-column: 1 / -1;
		}
	}
</style>
