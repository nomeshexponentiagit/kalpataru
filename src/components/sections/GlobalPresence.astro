---
import SectionLabel from '../ui/SectionLabel.astro';
---

<section class="section global" id="locations">
	<div class="container">
		<div class="section-head">
			<div>
				<SectionLabel text="Global presence" />
				<h2 class="section-head__title">
					One partner.<br />multiple markets.
				</h2>
			</div>
		</div>

		<!-- Dotted world map (public/images/world-map.svg, generated by
		     /tmp/kalpataru-verify/make-world-map.mjs from @svg-maps/world
		     geometry) with the four markets highlighted: accent-tinted
		     countries, pulsing markers and labels. Small screens scroll the
		     map sideways so the labels stay legible. -->
		<div class="global__map" data-reveal>
			<img
				src="/images/world-map.svg"
				alt="World map — Kalpataru Exhibition markets highlighted: India, Japan, China and the USA"
				loading="lazy"
				decoding="async"
				width="1010"
				height="666"
			/>
			<p class="global__hint">Swipe to explore the map</p>
		</div>
	</div>
</section>

<style>
	.global__map {
		margin-top: clamp(1rem, 3vw, 2.5rem);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: thin;
	}

	.global__map img {
		display: block;
		width: 100%;
		height: auto;
		/* keeps the country labels legible on small screens */
		min-width: 780px;
		margin-inline: auto;
	}

	.global__hint {
		display: none;
		margin-top: 0.9rem;
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	@media (max-width: 1023px) {
		.global__hint {
			display: block;
		}
	}
</style>
