---
import SectionLabel from '../ui/SectionLabel.astro';

/**
 * DUMMY TESTIMONIAL — the quote and name are invented and must be replaced
 * with a verified client quote.
 *
 * Client logos are REAL, pulled from the live kalpataruexhibition.com
 * "What We Have Clients" section (user-provided). TODO — give each logo
 * its real client name as alt text once provided.
 */
const CLIENT_LOGOS = Array.from({ length: 29 }, (_, i) => `/images/clients/client-logo-${i + 1}.png`);
---

<section class="section testimonials">
	<div class="container">
		<div class="testimonials__grid">
			<div class="testimonials__label" data-reveal>
				<SectionLabel text="Client trust" />
			</div>

			<figure class="testimonials__quote" data-reveal>
				<span class="testimonials__mark" aria-hidden="true">“</span>
				<blockquote>
					The stand was delivered on schedule and drew more traffic than any show we've done before.
					The team understood the brief without hand-holding.
				</blockquote>
				<figcaption>Rahul Deshmukh — Head of Marketing, Vertex Pharma</figcaption>
			</figure>
		</div>
	</div>

	<!-- real client logos — infinite marquee, pauses on hover, duplicated track for a seamless loop -->
	<div class="clients-marquee" data-reveal aria-label="Clients we have worked with">
		<div class="clients-marquee__track">
			<ul>
				{CLIENT_LOGOS.map((src) => (
					<li><img src={src} alt="Client logo" loading="eager" decoding="async" /></li>
				))}
			</ul>
			<ul aria-hidden="true">
				{CLIENT_LOGOS.map((src) => (
					<li><img src={src} alt="Client logo" loading="eager" decoding="async" /></li>
				))}
			</ul>
		</div>
	</div>
</section>

<style>
	.testimonials__grid {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: 2rem;
	}

	.testimonials__label {
		grid-column: 1 / 3;
	}

	.testimonials__quote {
		grid-column: 3 / 13;
	}

	.testimonials__mark {
		display: block;
		font-size: clamp(4rem, 8vw, 7rem);
		font-weight: 600;
		line-height: 0.55;
		color: var(--accent);
	}

	.testimonials__quote blockquote {
		margin-top: 1.75rem;
		font-size: clamp(1.55rem, 3vw, 2.6rem);
		font-weight: 500;
		letter-spacing: -0.015em;
		line-height: 1.25;
		max-width: 30ch;
	}

	.testimonials__quote figcaption {
		margin-top: 1.5rem;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.26em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	/* ------------------------------------------------ real client marquee */

	.clients-marquee {
		overflow: hidden;
		margin-top: clamp(3rem, 6vw, 5rem);
		border: 1px solid var(--line);
	}

	.clients-marquee__track {
		display: flex;
		width: max-content;
		animation: clients-scroll 48s linear infinite;
	}

	/* pause the belt while the visitor inspects a logo */
	.clients-marquee:hover .clients-marquee__track {
		animation-play-state: paused;
	}

	.clients-marquee ul {
		display: flex;
		align-items: center;
		gap: clamp(2rem, 4.5vw, 4rem);
		padding: 1.9rem 0;
		padding-right: clamp(2rem, 4.5vw, 4rem);
	}

	/* client logos stay in full colour */
	.clients-marquee img {
		height: 2.6rem;
		width: auto;
		opacity: 0.92;
		transition: opacity 0.4s var(--ease-swift), transform 0.4s var(--ease-swift);
	}

	.clients-marquee img:hover {
		opacity: 1;
		transform: translateY(-2px);
	}

	@keyframes clients-scroll {
		to {
			transform: translateX(-50%);
		}
	}

	@media (max-width: 1023px) {
		.testimonials__label {
			grid-column: 1 / -1;
		}

		.testimonials__quote {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 767px) {
		/* 12 track + gap system can't fit below ~390px; stack fully */
		.testimonials__grid {
			grid-template-columns: 1fr;
		}

		.clients-marquee img {
			height: 2.2rem;
		}
	}
</style>
